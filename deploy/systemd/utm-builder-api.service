[Unit]
Description=Ad Rock UTM Builder API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/utm_builder/server
EnvironmentFile=/var/www/utm_builder/server/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
User=www-data
Group=www-data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
